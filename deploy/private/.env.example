# Settings for compose.private.yaml (see docs/deployment.md, option 3).

# The portal's DNS name, in a Cloudflare zone. Point it (A record) at
# EZDR_PRIVATE_IP.
EZDR_DOMAIN=portal.example.com
EZDR_VERSION=0.1.0

# The server's private (VPN) address: the only place the web UI listens.
EZDR_PRIVATE_IP=100.92.0.10

# Where hosts reach the portal's WireGuard: the public address and port.
EZDR_WG_ENDPOINT=203.0.113.10:51820

# EZDR's tunnel ranges: not used on any host, and outside the VPN's range.
EZDR_TUNNEL_PREFIX=172.31.254.0/28
EZDR_SITE_TUNNEL_PREFIX=172.31.254.16/28

# A Cloudflare API token with Zone: DNS: Edit on EZDR_DOMAIN's zone (used
# only for the certificate).
CLOUDFLARE_API_TOKEN=
