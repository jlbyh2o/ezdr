# Caddy with the Cloudflare DNS module, for certificates from Let's Encrypt's
# DNS challenge (the portal isn't reachable from the internet). Built from
# the official Caddy images; see compose.private.yaml.
FROM caddy:2.11.4-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:2.11.4
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
